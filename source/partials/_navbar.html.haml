.navbar-wrapper
  .container
    .navbar.navbar-inverse.navbar-static-top{:role => "navigation"}
      .container
        .navbar-header
          %button.navbar-toggle.collapsed{"data-target" => ".navbar-collapse", "data-toggle" => "collapse", :type => "button"}
            %span.sr-only Toggle navigation
            %span.icon-bar
            %span.icon-bar
            %span.icon-bar
          = link_to I18n.t(:home), "index.html", class: "navbar-brand"
        .navbar-collapse.collapse
          %ul.nav.navbar-nav
            %li
              = link_to "Enucatl", "./enucatl.html"
            %li
              = link_to "Satrapame", "./satrapame.html"
            %li
              = link_to I18n.t(:tyrant), "./tirannomauro.html"
          %ul.nav.navbar-nav.navbar-right
            - if I18n.locale == :en
              %li
                %a{:href => "../index.html"} it
              %li
                %a{:href => "index.html"} en
            - else
              %li
                %a{:href => "index.html"} it
              %li
                %a{:href => "en/index.html"} en
